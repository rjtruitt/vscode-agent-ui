{
  "name": "vscode-agent-ui",
  "version": "1.0.0",
  "description": "Lightweight, framework-agnostic UI components for VS Code webviews",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "keywords": [
    "vscode",
    "vscode-extension",
    "webview",
    "ui-components",
    "typescript",
    "chat",
    "dashboard",
    "agent",
    "ai"
  ],
  "author": "Rob Truitt",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/vscode-agent-ui.git"
  },
  "bugs": {
    "url": "https://github.com/yourusername/vscode-agent-ui/issues"
  },
  "homepage": "https://github.com/yourusername/vscode-agent-ui#readme",
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "clean": "rm -rf dist",
    "prepublish": "npm run clean && npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/vscode": "^1.85.0",
    "@vitest/ui": "^4.1.6",
    "typescript": "^5.3.0",
    "vitest": "^4.1.6"
  },
  "engines": {
    "vscode": "^1.85.0",
    "node": ">=18.0.0"
  }
}
